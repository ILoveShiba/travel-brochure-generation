            <div class="editable-target" contenteditable="true" style="font-size: 13.5px; color: var(--sub-text); margin-top: 4px;">備註說明</div>
            <div class="doc-link-wrapper">
                <div style="margin-top: 8px;">
                    <a href="https://" target="_blank" class="doc-link-btn">
                        🔗 查看票券 / 圖檔連結
                    </a>
                </div>
            </div>
            <button type="button" class="btn-edit-link" style="margin-top: 6px;" onclick="editDocLinkUrl(this)">🔗 換連結</button>
        `;
