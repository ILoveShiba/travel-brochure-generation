    }

    (function() {
        const FIREBASE_DB_URL = "https://wanghomesapporotravel2026-default-rtdb.firebaseio.com/";
        const FIREBASE_ROOM_ID = "wang-family-hokkaido";
        const LOCAL_BUILD_TIME = "2026-10-05T03:50:26.698Z";
        const STORAGE_KEY = 'saved_guide_html_' + location.pathname;
        let isEditing = false;

        function getEndpoint() {
            if (!FIREBASE_DB_URL) return null;
            let base = FIREBASE_DB_URL.trim();
            if (!base.endsWith('/')) base += '/';
            return base + 'guides/' + encodeURIComponent(FIREBASE_ROOM_ID) + '.json';
        }

        window.addEventListener('DOMContentLoaded', () => {
            bindEvents();
            initCloudSync();
        });

        function bindEvents() {
            const editBtn = document.getElementById('guideEditToggleBtn');
            if (editBtn) editBtn.addEventListener('click', toggleEdit);

            const pdfBtn = document.getElementById('guidePrintPdfBtn');
            if (pdfBtn) pdfBtn.addEventListener('click', printToPdf);
        }

        function initCloudSync() {
            const endpoint = getEndpoint();
            const badge = document.getElementById('syncStatusBadge');
            const dot = document.getElementById('syncDot');
            const text = document.getElementById('syncStatusText');

            if (endpoint) {
                badge.style.display = 'flex';
                text.textContent = '雲端連線中...';
                fetch(endpoint)
                    .then(res => res.json())
                    .then(data => {
                        const cloudTime = data && data.updatedAt ? new Date(data.updatedAt).getTime() : 0;
                        const localTime = new Date(LOCAL_BUILD_TIME).getTime();

                        if (data && data.html && cloudTime > localTime) {
                            document.getElementById('guideMainContent').innerHTML = data.html;
                            text.textContent = '已同步最新雲端手冊';
                            dot.style.background = '#48bb78';
                        } else {
                            text.textContent = '本地版本較新，已自動更新至雲端';
                            dot.style.background = '#48bb78';
                            const mainHtml = document.getElementById('guideMainContent').innerHTML;
                            fetch(endpoint, {
                                method: 'PUT',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ html: mainHtml, updatedAt: new Date().toISOString() })
                            }).catch(() => {});
                        }
                    })
                    .catch(() => {
                        text.textContent = '離線模式 (使用本地檔案)';
                        dot.style.background = '#e53e3e';
                    });
            }
        }

        function toggleEdit() {
            isEditing = !isEditing;
            const currentBtn = document.getElementById('guideEditToggleBtn');
            document.body.classList.toggle('is-editing', isEditing);

            document.querySelectorAll('.editable-target').forEach(el => {
                el.contentEditable = isEditing ? 'true' : 'false';
            });

            if (isEditing) {
                currentBtn.textContent = '💾 儲存變更';
            } else {
                currentBtn.textContent = '✏️ 編輯內容';
                const mainHtml = document.getElementById('guideMainContent').innerHTML;

                try { localStorage.setItem(STORAGE_KEY, mainHtml); } catch(e) {}

                const endpoint = getEndpoint();
                if (endpoint) {
                    const text = document.getElementById('syncStatusText');
                    text.textContent = '正在上傳雲端...';
                    fetch(endpoint, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ html: mainHtml, updatedAt: new Date().toISOString() })
                    })
                    .then(() => {
                        text.textContent = '已即時同步至雲端！';
                        alert('🎉 變更已儲存，所有旅伴開啟此網頁時皆會同步更新！');
                    })
                    .catch(() => {
                        alert('已儲存至本機（雲端連線異常，請確認網路）！');
                    });
                } else {
                    alert('🎉 變更已成功儲存在此瀏覽器！');
                }
            }
        }

        function printToPdf() {
            const detailsList = document.querySelectorAll('details');
            const originalStates = Array.from(detailsList).map(d => d.hasAttribute('open'));

            detailsList.forEach(d => d.setAttribute('open', 'true'));
            window.print();

            setTimeout(() => {
                detailsList.forEach((d, idx) => {
                    if (!originalStates[idx]) d.removeAttribute('open');
                });
            }, 300);
        }
    })();
    </script>
</body>
