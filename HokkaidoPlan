    <script>
    // 景點時段上移 / 下移排序
    function moveSpotItem(btn, direction) {
        const item = btn.closest('.item-box');
        if (!item) return;
        if (direction === -1) {
            const prev = item.previousElementSibling;
            if (prev && prev.classList.contains('item-box')) {
                item.parentNode.insertBefore(item, prev);
            }
        } else if (direction === 1) {
            const next = item.nextElementSibling;
            if (next && next.classList.contains('item-box')) {
                item.parentNode.insertBefore(next, item);
            }
        }
    }

    // 監聽景點文字修改：失焦自動更新 Google Maps 超連結
    document.addEventListener('focusout', function(e) {
        if (e.target && e.target.classList.contains('spot-map-link')) {
            const newText = e.target.textContent.trim();
            if (newText) {
                e.target.href = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(newText);
            }
        }
    });

    // 手動設定 / 修改 Google 路線功能
    function editRouteForSpot(btn) {
        const transBox = btn.closest('.trans-info');
        const wrapper = transBox.querySelector('.route-link-wrapper');
        const currentLink = wrapper.querySelector('a.route-btn');
        const defaultVal = currentLink ? currentLink.href : '';

        const inputVal = prompt("請輸入 Google 路線網址，或輸入「起點 / 終點」自動生成：\n(例如：札幌車站 / 小樽運河，若欲刪除請清空留白)", defaultVal);
        if (inputVal === null) return;

        const val = inputVal.trim();
        if (!val) {
            wrapper.innerHTML = '';
        } else if (val.startsWith('http://') || val.startsWith('https://')) {
            wrapper.innerHTML = '<a class="route-btn" href="' + val + '" target="_blank">📍【google路線】</a>';
        } else if (val.includes('/') || val.includes('➔') || val.includes('到') || val.includes('-')) {
            const parts = val.split(/[\/➔到\-]/).map(s => s.trim()).filter(Boolean);
            if (parts.length >= 2) {
                const autoUrl = 'https://www.google.com/maps/dir/' + encodeURIComponent(parts[0]) + '/' + encodeURIComponent(parts[1]);
                wrapper.innerHTML = '<a class="route-btn" href="' + autoUrl + '" target="_blank">📍【google路線】</a>';
            } else {
                const searchUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(val);
                wrapper.innerHTML = '<a class="route-btn" href="' + searchUrl + '" target="_blank">📍【google路線】</a>';
            }
        } else {
            const searchUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(val);
            wrapper.innerHTML = '<a class="route-btn" href="' + searchUrl + '" target="_blank">📍【google路線】</a>';
        }
    }

