        const inputVal = prompt("請輸入新的優惠券網址 (若欲移除請留白清空)：", defaultVal);
        if (inputVal === null) return;

        const val = inputVal.trim();
        if (!val) {
            wrapper.innerHTML = '';
        } else {
            wrapper.innerHTML = '<a class="coupon-btn" href="' + val + '" target="_blank">👉 點此開啟電子優惠券</a>';
        }
