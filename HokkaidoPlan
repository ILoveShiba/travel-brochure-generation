                <div class="card" style="background-color: #fffaf0; border-color: #f6ad55; margin-bottom: 0;">
                    <span class="coupon-link-wrapper"><a class="coupon-btn" href="https://" target="_blank">👉 點此開啟電子優惠券</a></span>
                    <button type="button" class="btn-edit-link" onclick="editCouponUrl(this)">🔗 換連結</button>
                    <div class="editable-target" contenteditable="true" style="font-size: 13.5px; color: var(--sub-text); margin-top: 10px;">請在此點擊輸入折扣說明</div>
                </div>
            </div>
        `;
        wrapper.appendChild(newCoupon);
    }

    function addNewDocItem() {
        const wrapper = document.getElementById('docsWrapper');
        const newDoc = document.createElement('div');
        newDoc.className = 'card';
        newDoc.style.marginBottom = '10px';
        newDoc.innerHTML = `
